import SwiftUI

public struct AgentDashboardView: View {
    private let logger: JourneyLogging?
    
    public init(logger: JourneyLogging? = nil) {
        self.logger = logger
    }
    
    // Static placeholder data for now
    private let clients: [ClientStub] = [
        .init(name: "Ava Chen", stage: "Application in review"),
        .init(name: "Marcus Lee", stage: "Touring this week"),
        .init(name: "Noa Patel", stage: "Offer sent"),
        .init(name: "Diego Rivera", stage: "Board prep")
    ]
    
    public var body: some View {
        NavigationStack {
            List {
                Section("My Clients") {
                    ForEach(clients) { client in
                        HStack {
                            VStack(alignment: .leading, spacing: 4) {
                                Text(client.name).font(.headline)
                                Text(client.stage).font(.subheadline).foregroundColor(.secondary)
                            }
                            Spacer()
                            Text("View").font(.callout).foregroundStyle(.secondary)
                        }
                        .contentShape(Rectangle())
                    }
                }
                
                Section("Quick Actions") {
                    Label("Invite new client", systemImage: "person.badge.plus")
                    Label("Share checklist", systemImage: "checklist")
                    Label("Create referral code", systemImage: "qrcode")
                }
            }
            .navigationTitle("Agent Dashboard")
        }
        .onAppear {
            logger?.log("Viewed Dashboard: Agent", metadata: ["screen": "agent"])
        }
    }
}

// MARK: - Model

private struct ClientStub: Identifiable {
    let id = UUID()
    let name: String
    let stage: String
}


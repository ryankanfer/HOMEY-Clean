<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21507" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" colorMatched="YES" initialViewController="LAUNCH-VC">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21505"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen-->
        <scene sceneID="LAUNCH-SCENE">
            <objects>
                <viewController id="LAUNCH-VC" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="ROOT-VIEW">
                        <rect key="frame" x="0" y="0" width="393" height="852"/>
                        <!-- system background so it respects dark/light -->
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <subviews>
                            <!-- Center logo -->
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="homey_logo" translatesAutoresizingMaskIntoConstraints="NO" id="LOGO">
                                <rect key="frame" x="96" y="371" width="201" height="110"/>
                            </imageView>
                        </subviews>
                        <constraints>
                            <!-- center logo -->
                            <constraint firstItem="LOGO" firstAttribute="centerX" secondItem="ROOT-VIEW" secondAttribute="centerX" id="c1"/>
                            <constraint firstItem="LOGO" firstAttribute="centerY" secondItem="ROOT-VIEW" secondAttribute="centerY" id="c2"/>
                            <!-- size that scales well; adjust as you like -->
                            <constraint firstItem="LOGO" firstAttribute="width" secondItem="ROOT-VIEW" secondAttribute="width" multiplier="0.45" id="c3"/>
                            <constraint firstItem="LOGO" firstAttribute="height" secondItem="ROOT-VIEW" secondAttribute="height" multiplier="0.13" id="c4"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="SAFE"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FIRST" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="homey_logo" width="1024" height="1024"/>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>

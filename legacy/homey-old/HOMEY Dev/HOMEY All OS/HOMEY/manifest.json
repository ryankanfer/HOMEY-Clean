{
  "manifest_version": 3,
  "name": "HOMEY Save Listing",
  "version": "1.0.0",
  "description": "Capture listing fields from StreetEasy/Zillow and send to HOMEY on user tap.",
  "action": {
    "default_title": "Save to HOMEY"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://streeteasy.com/*",
    "https://www.streeteasy.com/*",
    "https://zillow.com/*",
    "https://www.zillow.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
